<!DOCTYPE html>
<html lang="pt-pt">

<%- include('partials/head') %>

<body>

    <%- include('partials/header') %>

    <main>
        <section class="hero-section text-center py-5">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <h1 class="display-3 fw-bold mb-3">SEU CARRO PAROU? <p><span class="text-warning">A GENTE RESOLVE.</span></p></h1>
                        <p class="lead mb-4 text-secondary">Especialistas em injeção eletrônica, baterias e motor de arranque. Qualidade técnica com a rapidez que você precisa.</p>
                        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                            <a href="#servicos" class="btn btn-outline-dark btn-lg px-4">Ver Serviços</a>
                            <a href="https://wa.me/<%= empresa.whatsapp %>" class="btn btn-warning btn-lg px-4 fw-bold">Chamar no WhatsApp</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="servicos" class="container my-5 py-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold">NOSSOS SERVIÇOS</h2>
                <div class="mx-auto bg-warning" style="height: 4px; width: 60px;"></div>
            </div>

            <div class="row g-4">
                <% servicos.forEach(servico => { %>
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 shadow-sm card-servico text-center p-4">
                            <div class="display-4 mb-3 text-warning">
                                <%= servico.icone %>
                            </div>
                            <h4 class="h5 fw-bold"><%= servico.titulo %></h4>
                            <p class="text-muted small mb-4"><%= servico.descricao %></p>
                            
                            <a href="https://wa.me/<%= empresa.whatsapp %>?text=Olá! Preciso de um orçamento para: <%= servico.titulo %>" 
                               class="btn btn-outline-dark btn-sm mt-auto" target="_blank">
                                <i class="bi bi-plus-circle"></i> SOLICITAR
                            </a>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

</body>
</html>