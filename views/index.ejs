<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= empresa.nome %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: sans-serif; }
        .hero { background: #212529; color: white; padding: 50px 0; }
        .card-servico { border: 1px solid #ddd; border-radius: 8px; padding: 20px; text-align: center; height: 100%; }
        .btn-whatsapp { background: #25d366; color: white; text-decoration: none; padding: 15px 25px; border-radius: 5px; font-weight: bold; display: inline-block; }
    </style>
</head>
<body>

    <header class="hero text-center">
        <h1><%= empresa.nome %></h1>
        <p><%= empresa.slogan %></p>
    </header>

    <main class="container my-5">
        <h2 class="text-center mb-4">Serviços Especializados</h2>
        <div class="row g-4">
            <% servicos.forEach(servico => { %>
                <div class="col-md-3">
                    <div class="card-servico shadow-sm">
                        <div class="display-4"><%= servico.icone %></div>
                        <h3><%= servico.titulo %></h3>
                        <p><%= servico.descricao %></p>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>

    <section class="text-center py-5 bg-light">
        <h3>Fale conosco agora!</h3>
        <a href="https://wa.me/<%= empresa.whatsapp %>" class="btn-whatsapp" target="_blank">
            Chamar no WhatsApp
        </a>
        <p class="mt-3"><%= empresa.endereco %></p>
    </section>

</body>
</html>